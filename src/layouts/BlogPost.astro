---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, lang, tags, heroImage } = post.data;
const slug = post.slug;

const canonicalURL = `https://www.speakcycle.com/blog/${slug}`;
const formattedDate = pubDate.toISOString();
const formattedUpdated = updatedDate?.toISOString() ?? formattedDate;

const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${canonicalURL}#article`,
      headline: title,
      description,
      datePublished: formattedDate,
      dateModified: formattedUpdated,
      inLanguage: lang === 'pt' ? 'pt-BR' : 'en-US',
      author: {
        '@type': 'Person',
        name: 'Professor Jordan',
        url: 'https://www.speakcycle.com/start',
        jobTitle: 'TEFL Level 5 Certified English Teacher',
        nationality: 'US',
      },
      publisher: {
        '@type': 'Organization',
        name: 'SpeakCycle',
        url: 'https://www.speakcycle.com',
        logo: {
          '@type': 'ImageObject',
          url: 'https://www.speakcycle.com/speakcycle-logo.png',
        },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
      ...(heroImage ? { image: heroImage } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'SpeakCycle', item: 'https://www.speakcycle.com/start' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://www.speakcycle.com/blog' },
        { '@type': 'ListItem', position: 3, name: title, item: canonicalURL },
      ],
    },
  ],
};
---

<!DOCTYPE html>
<html lang={lang === 'pt' ? 'pt-BR' : lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | SpeakCycle Blog</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content="article" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="SpeakCycle" />
  <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
  <meta property="og:image" content={heroImage ?? 'https://www.speakcycle.com/speakcycle-logo.png'} />
  <meta property="article:published_time" content={formattedDate} />
  <meta property="article:modified_time" content={formattedUpdated} />
  {tags.map(tag => <meta property="article:tag" content={tag} />)}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={heroImage ?? 'https://www.speakcycle.com/speakcycle-logo.png'} />

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@800;900&display=swap" rel="stylesheet" />

  <!-- GA4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-3J02L2DDVP"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-3J02L2DDVP');
  </script>
</head>
<body class="bg-white text-charcoal font-sans antialiased">

  <!-- Nav -->
  <nav class="bg-ink sticky top-0 z-10">
    <div class="max-w-5xl mx-auto px-4 py-3.5 flex items-center justify-between">
      <a href="https://www.speakcycle.com/start" class="font-head font-black uppercase tracking-wide text-white text-lg">SpeakCycle</a>
      <div class="flex items-center gap-5">
        <a href="/blog/" class="text-sm text-white/70 font-semibold hover:text-white">Blog</a>
        <a href="https://www.speakcycle.com/start" class="hidden sm:inline-flex bg-accent text-white font-head font-extrabold uppercase text-xs tracking-wide px-5 py-2.5 rounded-full">Inscreva-se</a>
      </div>
    </div>
  </nav>

  <!-- Header -->
  <header class="bg-sand">
    <div class="max-w-3xl mx-auto px-4 pt-10 pb-12">
      <nav class="text-sm text-body/60 mb-6 flex gap-2 flex-wrap">
        <a href="https://www.speakcycle.com/start" class="hover:text-accent">SpeakCycle</a>
        <span>/</span>
        <a href="/blog/" class="hover:text-accent">Blog</a>
      </nav>
      {tags.length > 0 && (
        <p class="font-head text-xs font-extrabold uppercase tracking-[1.5px] text-accent mb-4">{tags[0]}</p>
      )}
      <h1 class="font-head text-[clamp(30px,5vw,46px)] font-black leading-[1.08] tracking-tight text-ink mb-5">{title}</h1>
      <p class="text-lg text-body leading-relaxed mb-8">{description}</p>
      <div class="flex items-center gap-3">
        <img src="https://www.speakcycle.com/professor-jordan-520.webp" alt="Professor Jordan" width="48" height="48" class="w-12 h-12 rounded-full object-cover object-top bg-white" />
        <div class="text-sm leading-tight">
          <div class="font-bold text-ink">Professor Jordan</div>
          <time datetime={formattedDate} class="text-body/70">
            {pubDate.toLocaleDateString(lang === 'pt' ? 'pt-BR' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-3xl mx-auto px-4 py-12">
    {heroImage && <img src={heroImage} alt={title} class="w-full rounded-2xl mb-10 object-cover" />}

    <article class="post-body">
      <slot />
    </article>

    <!-- Author -->
    <aside class="mt-16 flex flex-col sm:flex-row gap-5 items-start bg-mist rounded-2xl p-6">
      <img src="https://www.speakcycle.com/professor-jordan-520.webp" alt="Professor Jordan" width="72" height="72" loading="lazy" class="w-[72px] h-[72px] rounded-full object-cover object-top bg-white shrink-0" />
      <div>
        <div class="font-head font-black uppercase text-ink">Sobre o autor</div>
        <p class="text-body leading-relaxed mt-2">Jordan é professor de inglês americano, da Califórnia, morando em Florianópolis. Certificado TEFL nível 5, ajuda brasileiros que já falam inglês a soarem naturais no trabalho, em entrevistas e em conversas reais.</p>
      </div>
    </aside>

    <!-- CTA -->
    <div class="mt-8 bg-ink rounded-2xl px-6 py-10 text-white text-center">
      <p class="font-head text-xs font-extrabold uppercase tracking-[1.5px] text-[#B794FF] mb-3">Próximo passo</p>
      <h2 class="font-head text-2xl sm:text-3xl font-black uppercase leading-tight mb-3">Aulas particulares com o Jordan, professor americano</h2>
      <p class="text-white/75 mb-7">Para quem já fala inglês e quer soar natural · Certificado TEFL nível 5</p>
      <a href="https://www.speakcycle.com/start" class="inline-flex bg-accent text-white font-head font-extrabold uppercase tracking-wide px-8 py-4 rounded-full">Quero me inscrever</a>
    </div>

    <!-- Free guide -->
    <a href="https://www.speakcycle.com/guia" class="mt-4 flex flex-col sm:flex-row sm:items-center gap-4 justify-between bg-sand rounded-2xl px-6 py-6 no-underline">
      <div>
        <div class="font-head font-black uppercase text-ink">Guia grátis: 20 frases que entregam que você está traduzindo</div>
        <p class="text-body mt-1">Reuniões, e-mails e entrevistas: o que brasileiros costumam dizer e o que um nativo diria.</p>
      </div>
      <span class="shrink-0 font-head font-extrabold uppercase text-sm text-accent">Baixar grátis →</span>
    </a>
  </main>

  <footer class="bg-[#0B0B18] py-6 text-center text-sm text-white/40">
    <p>© {new Date().getFullYear()} SpeakCycle · <a href="https://www.speakcycle.com/start" class="text-white/60 hover:text-white">Aulas particulares</a> · <a href="https://www.speakcycle.com/empresas" class="text-white/60 hover:text-white">Para empresas</a> · <a href="https://www.speakcycle.com/guia" class="text-white/60 hover:text-white">Guia grátis</a></p>
  </footer>

  <style is:global>
    .post-body { color: #3A3A4A; font-size: 18px; line-height: 1.75; }
    .post-body > * + * { margin-top: 1.25em; }
    .post-body h2 { font-family: 'Montserrat', 'Inter', sans-serif; font-weight: 900; color: #14142B; font-size: clamp(24px, 3.6vw, 30px); line-height: 1.2; letter-spacing: -0.3px; margin-top: 2.2em; }
    .post-body h3 { font-family: 'Montserrat', 'Inter', sans-serif; font-weight: 800; color: #14142B; font-size: 20px; line-height: 1.3; margin-top: 2em; }
    .post-body h2 + *, .post-body h3 + * { margin-top: 0.75em; }
    .post-body strong { color: #14142B; font-weight: 700; }
    .post-body a { color: #7B2FF7; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
    .post-body ul, .post-body ol { padding-left: 1.4em; }
    .post-body ul { list-style: disc; }
    .post-body ol { list-style: decimal; }
    .post-body li + li { margin-top: 0.5em; }
    .post-body li::marker { color: #7B2FF7; font-weight: 700; }
    .post-body blockquote { border-left: 4px solid #7B2FF7; padding: 4px 0 4px 18px; color: #14142B; font-weight: 600; }
    .post-body hr { border: 0; border-top: 1px solid #E5E5EA; margin: 2.5em 0; }
    .post-body code { background: #F3F3F5; padding: 2px 6px; border-radius: 6px; font-size: 0.9em; }
    .post-body table { width: 100%; border-collapse: collapse; font-size: 16px; }
    .post-body th, .post-body td { border-bottom: 1px solid #E5E5EA; padding: 10px 8px; text-align: left; }
    .post-body th { color: #14142B; }
    .post-body .compare { border-radius: 14px; overflow: hidden; border: 1px solid #E5E5EA; }
    .post-body .compare p { margin: 0; padding: 14px 18px 14px 48px; position: relative; font-size: 17px; line-height: 1.5; }
    .post-body .compare p::before { position: absolute; left: 18px; top: 14px; font-weight: 900; }
    .post-body .compare .bad { background: #FEF2F2; color: #7F1D1D; }
    .post-body .compare .bad s { text-decoration-color: rgba(220, 38, 38, 0.45); }
    .post-body .compare .bad::before { content: '✕'; color: #DC2626; }
    .post-body .compare .good { background: #F0FDF4; color: #14532D; font-weight: 600; }
    .post-body .compare .good::before { content: '✓'; color: #16A34A; }
    .post-body .compare .note { font-size: 15px; opacity: 0.75; }
    .post-body .compare .or { font-weight: 400; opacity: 0.6; margin: 0 4px; }
  </style>
</body>
</html>
